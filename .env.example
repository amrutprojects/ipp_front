# API base path or URL. Default /api/v1 (same origin: the dev proxy below, or a reverse proxy in production).
# For a separate API domain in production, e.g. https://api.example.com/api/v1 (and add https://ipp.sumago.ai to the
# API's FRONTEND_URL).
VITE_API_BASE_URL=/api/v1
# Dev server only: where /api is forwarded (sarthi-api).
VITE_API_PROXY_TARGET=http://localhost:5001
